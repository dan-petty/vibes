# Local Environment Variables for Agent Observability & Sandbox Compose Stack
# All values are standardized documentation defaults compliant with Zero-Trust Sanitization.

# Jaeger Configuration
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
# No default is provided on purpose. Generate one, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Valkey L2 Cache Configuration
VALKEY_PORT=6379
VALKEY_MAX_MEMORY=256mb

# Mock Ingestion Endpoints (Standardized Documentation Hostnames)
AGENT_TEST_ENDPOINT=http://example.com/v1
AGENT_LOCAL_COLLECTOR=http://localhost:4318/v1/traces
